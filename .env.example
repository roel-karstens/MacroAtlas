# Public values only. Leave blank to run on checked-in snapshots.
# The only approved Supabase project is Macro Atlas, ref worlgpganiczzjwmapjk.
# Do not point these at any other project. Do not put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC. Not read by the browser.
# Not required for this edition, and not a reason to print the value.
# SUPABASE_SERVICE_ROLE_KEY=

# Newsletter sending stays off. Do not set RESEND_FROM to puurwatt.nl.
# RESEND_ENABLED=false
# RESEND_API_KEY=
# RESEND_FROM=
